{
  "name": "@ai-crew-suite/eslint-shared-config",
  "description": "Extensible ESLint flat configurations bundled with Rollup.",
  "version": "0.0.1",
  "keywords": [
    "ai-crew-suite",
    "ai-orchestration",
    "backstage",
    "eslint"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "packages/eslint-shared-config"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "npm run clean && rollup -c rollup.config.ts --configPlugin typescript",
    "clean": "crew clean",
    "lint": "yarn sync-config-types && crew lint",
    "prepublishOnly": "npm run build",
    "test:unit": "yarn sync-config-types && crew test:unit",
    "test:unit:coverage": "yarn sync-config-types && crew test:unit:coverage",
    "typecheck": "yarn sync-config-types && crew typecheck"
  },
  "dependencies": {
    "@eslint/js": "catalog:prod",
    "globals": "catalog:prod",
    "typescript-eslint": "catalog:prod"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "tslib": "catalog:dev"
  },
  "peerDependencies": {
    "eslint": "*",
    "typescript": "*"
  }
}
