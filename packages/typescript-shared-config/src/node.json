{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "${configDir}/dist"
  },
  "include": [
    "${configDir}/src/**/*"
  ],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist"
  ]
}
