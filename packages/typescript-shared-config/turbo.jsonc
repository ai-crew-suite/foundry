{
  "extends": ["//"],
  "tasks": {
    /** Build requires crew-cli's dist/ because the build script invokes `crew clean`. */
    "build": {
      "cache": true,
      "dependsOn": ["@ai-crew-suite/crew-cli#build"]
    },
    "build:node": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/scripts/merge-tsconfig.ts", "src/base.json", "src/node.json"],
      "outputs": ["dist/node.json"]
    },
    "build:web": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/scripts/merge-tsconfig.ts", "src/base.json", "src/web.json"],
      "outputs": ["dist/web.json"]
    },
    /** Remove dependsOn from lint task that does not depend on Crew CLI for package */
    "lint": {
      "cache": true,
      "dependsOn": []
    },
    "lint:node": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/base.json", "src/node.json"],
      "outputs": []
    },
    "lint:web": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/base.json", "src/web.json"],
      "outputs": []
    }
  }
}
