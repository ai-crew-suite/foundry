{
  "name": "@ai-crew-suite/typescript-shared-config",
  "description": "Extensible and reusable TypeScript configurations.",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "keywords": [
    "ai-crew-suite",
    "tsconfig",
    "typescript"
  ],
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "packages/typescript-shared-config"
  },
  "files": [
    "base.json",
    "node.json",
    "web.json"
  ],
  "exports": {
    "./node": "./node.json",
    "./web": "./web.json"
  },
  "scripts": {
    "clean": "shx rm -rf dist && shx mkdir -p dist",
    "build": "yarn clean && yarn build:node && yarn build:web",
    "build:node": "yarn tsx src/scripts/merge-tsconfig.ts src/node.json dist/node.json",
    "build:web": "yarn tsx src/scripts/merge-tsconfig.ts src/web.json dist/web.json",
    "lint": "prettier --check \"src/**/*.json\" \"*.json\" && yarn lint:node && yarn lint:web",
    "lint:node": "tsc --project src/node.json --showConfig > /dev/null",
    "lint:web": "tsc --project src/web.json --showConfig > /dev/null",
    "test:unit": "vitest run src/scripts/__tests__/merge-tsconfig.test.ts",
    "format": "prettier --write \"src/**/*.json\" \"*.json\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "workspace:*",
    "@rollup/plugin-typescript": "catalog:dev",
    "@types/node": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "shx": "catalog:dev",
    "tsx": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "typescript": "*"
  }
}
