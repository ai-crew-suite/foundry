{
  "name": "@ai-crew-suite/playwright-shared-config",
  "description": "Extensible Playwright flat configurations written in TypeScript.",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "engines": {
    "node": "22 || 24"
  },
  "keywords": [
    "ai-crew-suite",
    "playwright",
    "config"
  ],
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "packages/playwright-shared-config"
  },
  "type": "module",
  "main": "./dist/base.js",
  "files": [
    "dist"
  ],
  "exports": {
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && rollup -c rollup.config.ts --configPlugin typescript",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": "*"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "workspace:*",
    "@rollup/plugin-typescript": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "tslib": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
