{
  "name": "@ai-crew-suite/renovate-shared-config",
  "description": "Centralized, high-compliance Renovate dependency presets for the AI Crew Suite platform.",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "keywords": [
    "ai-crew-suite",
    "renovate",
    "config",
    "preset"
  ],
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@4.18.0",
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "packages/renovate-shared-config"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "default.json",
  "files": [
    "default.json",
    "README.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "yarn clean && shx mkdir -p dist && shx cp src/default.json dist/default.json",
    "lint": "prettier --check \"src/**/*.json\" \"*.json\"",
    "format": "prettier --write \"src/**/*.json\" \"*.json\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "workspace:*",
    "@rollup/plugin-typescript": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "shx": "catalog:dev",
    "tslib": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "renovate-config": {
    "default": "./default.json"
  }
}
