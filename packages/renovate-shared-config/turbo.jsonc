{
  "extends": ["//"],
  /** Remove dependsOn for package tasks that do not depend on Crew CLI */
  "tasks": {
    "build": {
      "cache": true,
      // The build script invokes `crew clean`, which requires crew-cli's built
      // dist/ artifacts to exist before this task can start.
      "dependsOn": ["@ai-crew-suite/crew-cli#build"],
      "inputs": ["src/default.json"],
      "outputs": ["dist/default.json"]
    },
    "format": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "lint": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
