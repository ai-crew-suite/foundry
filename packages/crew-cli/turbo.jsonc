{
  "extends": ["//"],
  /** Remove dependsOn for tasks in Crew CLI package */
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/**", "package.json"],
      "outputs": ["dist/**"]
    },
    /**
     * Crew CLI's own clean removes dist/, which is where the `crew` bin shim
     * that all sibling packages' `crew clean` scripts execute lives. It must
     * wait until every sibling clean task has completed to avoid a race that
     * fails them with MODULE_NOT_FOUND.
     */
    "clean": {
      "cache": false,
      "dependsOn": [
        "@ai-crew-suite/backstage-config-typegen#clean",
        "@ai-crew-suite/renovate-shared-config#clean",
        "@ai-crew-suite/typescript-shared-config#clean",
        "@ai-crew-suite/yarn-plugin-custom-add#clean"
      ]
    },
    "lint": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test:unit": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/**"],
      "outputs": []
    },
    "test:unit:coverage": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/**"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    }
  }
}
