{
  "name": "@ai-crew-suite/yarn-plugin-custom-add",
  "description": "Yarn plugin redirecting \"yarn add\" onto named catalogs in .yarnrc.yml",
  "version": "0.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "ai-crew-suite",
    "yarn",
    "yarn-plugin",
    "catalogs"
  ],
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "packages/yarn-plugin-custom-add"
  },
  "main": "./dist/plugin.cjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && rollup -c rollup.config.ts --configPlugin esbuild",
    "clean": "crew clean",
    "lint": "crew lint",
    "test": "yarn test:unit && yarn test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "@yarnpkg/core": "catalog:prod",
    "clipanion": "catalog:prod",
    "npm-package-arg": "catalog:prod"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "workspace:*",
    "@rollup/plugin-commonjs": "catalog:dev",
    "@rollup/plugin-json": "catalog:dev",
    "@types/npm-package-arg": "catalog:dev",
    "esbuild": "catalog:dev",
    "execa": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "rollup-plugin-esbuild": "catalog:dev",
    "tslib": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
