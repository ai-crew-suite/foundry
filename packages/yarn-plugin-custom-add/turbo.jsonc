{
  "extends": ["//"],
  /** Remove dependsOn for package tasks that do not depend on Crew CLI */
  "tasks": {
    "build": {
      "cache": true,
      // Overrides root to remove upstream package dependencies while retaining environment safety markers.
      // crew-cli#build is retained because the build script invokes `crew clean`,
      // which requires crew-cli's built dist/ artifacts to exist before this task can start.
      "dependsOn": ["@ai-crew-suite/crew-cli#build"],
      "inputs": ["src/**", "package.json"],
      "outputs": ["dist/**"]
    },
    "test:integration": {
      "cache": false, // Integration tests write volatile global OS temporary dirs; never cache them
      // Force a clean localized production compilation run before spawning E2E processes
      "dependsOn": ["build"],
      "inputs": ["src/__tests__/**/*.integration.test.ts"],
      "outputs": []
    }
  }
}
