{
  "$schema": "https://turbo.build",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "cache": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "compose:up": {
      "cache": false,
      "persistent": true
    },
    "compose:down": {
      "cache": false
    },
    "image:build": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": []
    },
    "helm:lint": {
      "cache": true,
      "outputs": []
    },
    "helm:template": {
      "cache": true,
      "outputs": []
    },
    "tf:init": {
      "cache": true,
      "outputs": [".terraform/**", ".terraform.lock.hcl"]
    },
    "tf:validate": {
      "dependsOn": ["tf:init"],
      "cache": true,
      "outputs": []
    },
    "tf:plan": {
      "dependsOn": ["tf:validate"],
      "cache": false,
      "passThroughEnv": [
        "TF_VAR_database_secure_password",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_DEFAULT_REGION"
      ]
    }
  }
}
