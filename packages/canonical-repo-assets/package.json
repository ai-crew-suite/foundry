{
  "name": "@ai-crew-suite/canonical-repo-assets",
  "description": "Centralized repository assets for the AI Crew Suite platform.",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "keywords": [
    "ai-crew-suite",
    "config"
  ],
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@4.18.0",
  "private": true,
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "packages/canonical-repo-assets"
  },
  "main": "manifest.json",
  "files": [
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && rollup -c rollup.config.ts --configPlugin typescript",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "workspace:*",
    "@rollup/plugin-typescript": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "tslib": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
