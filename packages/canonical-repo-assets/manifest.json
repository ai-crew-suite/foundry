{
  "default": [
    {
      "name": "Governance Documentation",
      "repos": [
        "ai-crew-suite/academy",
        "ai-crew-suite/agents",
        "ai-crew-suite/drivers",
        "ai-crew-suite/foundry",
        "ai-crew-suite/pipelines",
        "ai-crew-suite/platform",
        "ai-crew-suite/workbench"
      ],
      "files": [
        {
          "source": "templates/governance/CODE_OF_CONDUCT.md",
          "dest": "CODE_OF_CONDUCT.md"
        },
        {
          "source": "templates/governance/CONTRIBUTING.md",
          "dest": "CONTRIBUTING.md"
        },
        {
          "source": "templates/governance/LICENSE",
          "dest": "LICENSE"
        },
        {
          "source": "templates/governance/OWNERS.md",
          "dest": "OWNERS.md"
        },
        {
          "source": "templates/governance/SECURITY.md",
          "dest": "SECURITY.md"
        },
        {
          "source": "templates/governance/config.yml",
          "dest": ".github/ISSUE_TEMPLATE/config.yml"
        },
        {
          "source": "templates/governance/BUG_TEMPLATE.md",
          "dest": ".github/ISSUE_TEMPLATE/BUG_TEMPLATE.md"
        },
        {
          "source": "templates/governance/CODEOWNERS",
          "dest": ".github/CODEOWNERS"
        },
        {
          "source": "templates/governance/FEATURE_TEMPLATE.md",
          "dest": ".github/ISSUE_TEMPLATE/FEATURE_TEMPLATE.md"
        },
        {
          "source": "templates/governance/PULL_REQUEST_TEMPLATE.md",
          "dest": ".github/PULL_REQUEST_TEMPLATE.md"
        }
      ]
    },
    {
      "name": "Project Root Dotfiles",
      "repos": [
        "ai-crew-suite/academy",
        "ai-crew-suite/agents",
        "ai-crew-suite/drivers",
        "ai-crew-suite/foundry",
        "ai-crew-suite/pipelines",
        "ai-crew-suite/platform",
        "ai-crew-suite/workbench"
      ],
      "files": [
        {
          "source": "templates/dotfiles/.dockerignore",
          "dest": ".dockerignore"
        },
        {
          "source": "templates/dotfiles/.gitattributes",
          "dest": ".gitattributes"
        },
        {
          "source": "templates/dotfiles/.gitignore",
          "dest": ".gitignore"
        },
        {
          "source": "templates/dotfiles/.hintrc",
          "dest": ".hintrc"
        },
        {
          "source": "templates/dotfiles/.markdownlint.json",
          "dest": ".markdownlint.json"
        },
        {
          "source": "templates/dotfiles/.npmrc",
          "dest": ".npmrc"
        },
        {
          "source": "templates/dotfiles",
          "dest": ""
        }
      ]
    },
    {
      "name": "Backstage Version",
      "repos": [
        "ai-crew-suite/agents",
        "ai-crew-suite/drivers",
        "ai-crew-suite/foundry",
        "ai-crew-suite/platform",
        "ai-crew-suite/workbench"
      ],
      "files": [
        {
          "source": "templates/backstage.json",
          "dest": "./backstage.json"
        }
      ]
    },
    {
      "name": "Husky Hooks",
      "repos": [
        "ai-crew-suite/academy",
        "ai-crew-suite/agents",
        "ai-crew-suite/drivers",
        "ai-crew-suite/foundry",
        "ai-crew-suite/pipelines",
        "ai-crew-suite/platform",
        "ai-crew-suite/workbench"
      ],
      "files": [
        {
          "source": "templates/husky/pre-commit",
          "dest": ".husky/pre-commit"
        }
      ]
    }
  ]
}
