{
  "name": "@ai-crew-suite/backstage-config-typegen",
  "description": "CLI that synchronizes Backstage config.d.ts schema types into a plugin's runtime source tree",
  "version": "0.0.2",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "ai-crew-suite",
    "backstage",
    "codegen",
    "config"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "packages/backstage-config-typegen"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "backstage-config-typegen": "./dist/bin/sync-config.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "crew clean",
    "build": "yarn clean && rollup -c rollup.config.ts --configPlugin esbuild",
    "lint": "crew lint",
    "test:unit": "crew test:unit",
    "test:unit:coverage": "crew test:unit:coverage",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "typescript": "catalog:prod"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "workspace:*",
    "@types/node": "catalog:dev",
    "esbuild": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "rollup-plugin-esbuild": "catalog:dev",
    "vitest": "catalog:prod"
  }
}
