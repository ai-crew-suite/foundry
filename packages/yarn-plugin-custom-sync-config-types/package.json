{
  "name": "@ai-crew-suite/yarn-plugin-custom-sync-config-types",
  "description": "CLI that synchronizes Backstage config.d.ts schema types into a plugin's runtime source tree",
  "version": "0.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "ai-crew-suite",
    "backstage",
    "codegen",
    "config"
  ],
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/foundry/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/foundry",
    "directory": "packages/yarn-plugin-custom-sync-config-types"
  },
  "main": "./dist/sync.js",
  "types": "./dist/sync.d.ts",
  "bin": {
    "sync-config-types": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && rollup -c rollup.config.ts --configPlugin typescript",
    "lint": "crew lint",
    "test:unit": "crew test:unit",
    "test:unit:coverage": "crew test:unit:coverage",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "typescript": "catalog:prod"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "catalog:dev",
    "@types/node": "catalog:dev",
    "rollup": "catalog:dev",
    "vitest": "catalog:prod"
  }
}
