{
  "name": "@ai-crew-suite/foundry",
  "description": "CLI and shared config packages for the AI Crew Suite monorepo",
  "private": true,
  "engines": {
    "node": "22 || 24",
    "npm": "Please use Yarn instead (Corepack enable)"
  },
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "clean:node_modules": "find packages -name node_modules -type d -exec rm -rf {} +",
    "clean:install": "rm -f package-lock.json yarn.lock && yarn cache clean && yarn install",
    "format:turbo": "node node_modules/@turbo/codemod/dist/cli.js migrate .",
    "install:setup": "husky",
    "lint": "turbo lint",
    "lint:changed": "turbo lint --filter=[HEAD~1]",
    "lint:turbo": "node node_modules/@turbo/codemod/dist/cli.js migrate . --dry --print",
    "sync": "crew sync:refs",
    "test": "yarn test:unit && yarn test:e2e && yarn test:unit:coverage",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "typecheck": "turbo typecheck",
    "typecheck:full": "turbo typecheck --force"
  },
  "devDependencies": {
    "@ai-crew-suite/crew-cli": "workspace:*",
    "@backstage/cli": "catalog:dev",
    "@backstage/cli-defaults": "catalog:dev",
    "@backstage/cli-module-new": "catalog:dev",
    "@backstage/config": "catalog:dev",
    "@changesets/cli": "catalog:dev",
    "@playwright/test": "catalog:dev",
    "@turbo/codemod": "catalog:dev",
    "@types/node": "catalog:dev",
    "concurrently": "catalog:dev",
    "http-server": "catalog:dev",
    "husky": "catalog:dev",
    "i18next": "catalog:dev",
    "lint-staged": "catalog:dev",
    "node-gyp": "catalog:dev",
    "only-allow": "catalog:dev",
    "prettier": "catalog:dev",
    "prop-types": "catalog:dev",
    "storybook": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "whatwg-fetch": "catalog:dev"
  },
  "resolutions": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "got": "11.8.6",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --config packages/config-eslint/eslint.monorepo.config.ts --fix"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
