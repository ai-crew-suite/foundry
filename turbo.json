{
  "$schema": "./node_modules/turbo/schema.json",
  "concurrency": "75%",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "BACKSTAGE_APP_CONFIG",
    "BACKSTAGE_USER_SECRET",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "sync"],
      "outputs": ["dist/**"],
      "env": [
        "FORCE_COLOR",
        "PLAYWRIGHT_APP_HOST",
        "PLAYWRIGHT_APP_PORT",
        "PLAYWRIGHT_BACKEND_HOST",
        "PLAYWRIGHT_BACKEND_PORT"
      ]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "publish-packages": {
      "dependsOn": ["lint", "typecheck", "test:unit", "build"],
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "start-backend": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "sync": {
      "inputs": [
        "packages/**/package.json"
      ],
      "outputs": [
        "packages/**/tsconfig.json",
        "tsconfig.json"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test:unit:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*",
        "src/**/*.test.ts"
      ],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
